rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /Books/{bookId} {
      // anyone can read the books collection
      allow read: if true;

      // Only logged-in users can add new books
      allow create: if request.auth != null;

      // Only logged-in users can update or delete
      // TODO: change so only admin and the user who created the book can update or delete it
      allow update, delete: if request.auth != null;
    }

    match /users/{userId} {
      // anyone can read the users collection
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}